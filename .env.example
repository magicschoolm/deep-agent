# ── Required ─────────────────────────────────────────────────────────────
# Used for the default Anthropic models across all agent roles.
ANTHROPIC_API_KEY=

# Used for all web search (Tavily_search tool).
TAVILY_API_KEY=

# ── Optional ─────────────────────────────────────────────────────────────
# Only needed if you select these providers in the Streamlit sidebar.

# OpenAI (gpt-4.1, gpt-4o, o4-mini, ...)
OPENAI_API_KEY=

# Google Gemini (gemini-2.5-pro, gemini-2.5-flash, ...)
GOOGLE_API_KEY=

# Groq (llama-3.3-70b-versatile, deepseek-r1-distill-llama-70b, ...)
GROQ_API_KEY=
